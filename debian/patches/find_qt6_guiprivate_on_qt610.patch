+# Since Qt 6.10 private module targets ship as standalone CMake packages and
+# are no longer auto-created by the module's targets file, so fetch the
+# private package explicitly when needed (Qt <= 6.9 keeps old behavior).
+if (NOT TARGET Qt6::GuiPrivate)
+    find_package(Qt6GuiPrivate ${REQUIRED_QT_VERSION} REQUIRED NO_MODULE)
+endif()
